<Window x:Class="WinSentryAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:views="clr-namespace:WinSentryAI.Views"
        xmlns:viewmodels="clr-namespace:WinSentryAI.ViewModels"
        mc:Ignorable="d"
        Title="WinSentryAI" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <!-- DataTemplates to map ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
            <views:EventListView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SystemInfoViewModel}">
            <views:SystemInfoView DataContext="{Binding}"/>
        </DataTemplate>

        <!-- Tab button style for detail panel tabs -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="80"/> <!-- 左側導覽區 -->
            <ColumnDefinition Width="4"/>                 <!-- 垂直分隔線 -->
            <ColumnDefinition Width="*"/>                 <!-- 主要工作區 -->
        </Grid.ColumnDefinitions>

        <!-- 左側導覽區 -->
        <hc:SideMenu Grid.Column="0">
            <hc:SideMenuItem Header="{DynamicResource Nav_EventLog}" Command="{Binding NavigateCommand}" CommandParameter="EventList">
                <hc:SideMenuItem.Style>
                    <Style TargetType="hc:SideMenuItem" BasedOn="{StaticResource SideMenuItemBaseStyle}">
                        <Setter Property="hc:IconElement.Geometry" Value="{StaticResource MonitorGeometry}"/>
                    </Style>
                </hc:SideMenuItem.Style>
            </hc:SideMenuItem>
            <hc:SideMenuItem Header="{DynamicResource Nav_SystemInfo}" Command="{Binding NavigateCommand}" CommandParameter="SystemInfo">
                <hc:SideMenuItem.Style>
                    <Style TargetType="hc:SideMenuItem" BasedOn="{StaticResource SideMenuItemBaseStyle}">
                        <Setter Property="hc:IconElement.Geometry" Value="{StaticResource InfoGeometry}"/>
                    </Style>
                </hc:SideMenuItem.Style>
            </hc:SideMenuItem>
            <hc:SideMenuItem Header="{DynamicResource Nav_AIReport}" Command="{Binding NavigateCommand}" CommandParameter="AIReport">
                <hc:SideMenuItem.Style>
                    <Style TargetType="hc:SideMenuItem" BasedOn="{StaticResource SideMenuItemBaseStyle}">
                        <Setter Property="hc:IconElement.Geometry" Value="{StaticResource ChartGeometry}"/>
                    </Style>
                </hc:SideMenuItem.Style>
            </hc:SideMenuItem>
            <hc:SideMenuItem Header="{DynamicResource Nav_Settings}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                <hc:SideMenuItem.Style>
                    <Style TargetType="hc:SideMenuItem" BasedOn="{StaticResource SideMenuItemBaseStyle}">
                        <Setter Property="hc:IconElement.Geometry" Value="{StaticResource SettingsGeometry}"/>
                    </Style>
                </hc:SideMenuItem.Style>
            </hc:SideMenuItem>
        </hc:SideMenu>

        <!-- 垂直 GridSplitter（可拖拉調整側邊欄寬度） -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Opacity="0.4"/>

        <!-- 右側主要區域 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>              <!-- Row 0: 主要內容 -->
                <RowDefinition Height="4"/>              <!-- Row 1: 水平 GridSplitter -->
                <RowDefinition Height="300" MinHeight="150"/> <!-- Row 2: 底部詳細面板 -->
                <RowDefinition Height="30"/>             <!-- Row 3: 底部狀態列 -->
            </Grid.RowDefinitions>

            <!-- Row 0: 主要內容區 -->
            <ContentControl Grid.Row="0" Content="{Binding CurrentViewModel}"/>

            <!-- Row 1: 水平 GridSplitter -->
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" Opacity="0.4"/>

            <!-- Row 2: 底部詳細面板 -->
            <Grid Grid.Row="2" DataContext="{Binding EventDetailViewModel}"
                  Background="{DynamicResource RegionBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tab header bar -->
                    <RowDefinition Height="*"/>    <!-- Tab content -->
                </Grid.RowDefinitions>

                <!-- Tab header bar -->
                <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                    <DockPanel>
                        <!-- AI Analyze button (right) -->
                        <Button DockPanel.Dock="Right"
                                Command="{Binding AnalyzeCommand}"
                                Content="{DynamicResource AI_Button_Analyze}"
                                Style="{StaticResource ButtonPrimary}"
                                Margin="8,4" Padding="12,4" VerticalAlignment="Center"/>

                        <!-- Tab buttons (left) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="DetailTab" Style="{StaticResource TabButtonStyle}"
                                         Content="{DynamicResource EventDetail_Tab_Detail}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Detail}"/>
                            <RadioButton GroupName="DetailTab" Style="{StaticResource TabButtonStyle}"
                                         Content="{DynamicResource EventDetail_Tab_AI}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=AI}"/>
                            <RadioButton GroupName="DetailTab" Style="{StaticResource TabButtonStyle}"
                                         Content="{DynamicResource EventDetail_Tab_Context}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Context}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tab content area -->
                <Grid Grid.Row="1">

                    <!-- ══════════════════════════════════════════ -->
                    <!-- Tab 1: Event Detail                        -->
                    <!-- ══════════════════════════════════════════ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Detail">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="16,10">
                            <!-- No event selected placeholder -->
                            <hc:Empty Description="{DynamicResource EventDetail_SelectEventPrompt}">
                                <hc:Empty.Style>
                                    <Style TargetType="hc:Empty">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:Empty.Style>
                            </hc:Empty>

                            <!-- Event fields (2-column layout) -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource EventDetail_Label_Source}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEvent.Source}" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource EventDetail_Label_Timestamp}" FontWeight="SemiBold" Margin="16,4,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedEvent.Timestamp}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource EventDetail_Label_ProviderName}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.ProviderName}" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource EventDetail_Label_EventId}" FontWeight="SemiBold" Margin="16,4,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedEvent.EventId}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource EventDetail_Label_Level}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.Level}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource EventDetail_Label_Host}" FontWeight="SemiBold" Margin="16,4,8,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedEvent.Host}" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource EventDetail_Label_Message}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                           Text="{Binding SelectedEvent.Message}" TextWrapping="Wrap" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════════════════════════════ -->
                    <!-- Tab 2: AI Analysis                         -->
                    <!-- ══════════════════════════════════════════ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="AI">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Scrollable AI content -->
                            <RowDefinition Height="Auto"/> <!-- Pinned disclaimer + chat input -->
                        </Grid.RowDefinitions>

                        <!-- Scrollable AI content -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,10">

                                <!-- Idle hint -->
                                <TextBlock Text="{DynamicResource AI_Status_Idle}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiIdle}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- No key configured -->
                                <Border CornerRadius="4" Padding="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiNoKey}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{DynamicResource AI_Status_NoKey}" TextWrapping="Wrap" Foreground="White"/>
                                </Border>

                                <!-- Loading -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <hc:LoadingCircle IsRunning="True" Width="20" Height="20"/>
                                    <TextBlock Text="{DynamicResource AI_Status_Loading}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- Failure -->
                                <Border CornerRadius="4" Padding="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiFailure}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AI_Status_Failure}" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{Binding AiErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="White"/>
                                    </StackPanel>
                                </Border>

                                <!-- Success: AI response + chat history -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiSuccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource AI_Result_ModelLabel}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AiModelName}" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <TextBox Text="{Binding AiResponseText, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalScrollBarVisibility="Disabled"/>

                                    <!-- Chat history bubbles -->
                                    <hc:Divider Margin="0,8"/>
                                    <ItemsControl ItemsSource="{Binding ChatHistory}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,3" MaxWidth="600"
                                                        HorizontalAlignment="{Binding Role, Converter={StaticResource ChatRoleToAlignmentConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="User">
                                                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                                                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="User">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Chat loading indicator -->
                                    <hc:LoadingCircle IsRunning="{Binding IsChatLoading}"
                                                      Width="20" Height="20" HorizontalAlignment="Center" Margin="0,4">
                                        <hc:LoadingCircle.Style>
                                            <Style TargetType="hc:LoadingCircle">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChatLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:LoadingCircle.Style>
                                    </hc:LoadingCircle>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pinned: Disclaimer + Chat input (OUTSIDE ScrollViewer) -->
                        <Border Grid.Row="1" Padding="16,8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiSuccess}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource AI_Disclaimer_Text}"
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:TextBox Grid.Column="0"
                                                Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                                hc:InfoElement.Placeholder="{DynamicResource AI_Chat_Placeholder}">
                                        <hc:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}"/>
                                        </hc:TextBox.InputBindings>
                                    </hc:TextBox>
                                    <Button Grid.Column="1" Command="{Binding SendChatCommand}"
                                            Style="{StaticResource ButtonPrimary}"
                                            Padding="10,0" Margin="6,0,0,0">
                                        <Path Data="{StaticResource ChartGeometry}" Width="12" Height="12"
                                              Stretch="Uniform" Fill="White"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ══════════════════════════════════════════ -->
                    <!-- Tab 3: Context Events                      -->
                    <!-- ══════════════════════════════════════════ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Context">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <hc:LoadingCircle Grid.Row="0" IsRunning="{Binding IsContextLogsLoading}"
                                          Width="24" Height="24" HorizontalAlignment="Center" Margin="8">
                            <hc:LoadingCircle.Style>
                                <Style TargetType="hc:LoadingCircle">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContextLogsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:LoadingCircle.Style>
                        </hc:LoadingCircle>

                        <Grid Grid.Row="1">
                            <hc:Empty Description="{DynamicResource EventDetail_NoContextLogs}"
                                      Visibility="{Binding ContextLogs.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <ListView ItemsSource="{Binding ContextLogs}" Margin="8,4">
                                <ListView.Style>
                                    <Style TargetType="ListView">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                        <Setter Property="ItemContainerStyle">
                                            <Setter.Value>
                                                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItemBaseStyle}">
                                                    <Setter Property="Padding" Value="2"/>
                                                </Style>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContextLogs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Message}">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss '}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Level, StringFormat='{}{0}: '}" FontWeight="SemiBold"
                                                       Foreground="{Binding Level, Converter={StaticResource EventLevelToColorConverter}}"/>
                                            <TextBlock Text="{Binding Source, StringFormat='{}{0} '}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EventId, StringFormat='(ID:{0})'}" FontStyle="Italic"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Row 3: 底部狀態列 -->
            <StatusBar Grid.Row="3" Background="{DynamicResource SecondaryRegionBrush}"
                       BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InfoGeometry}" Width="12" Height="12" Margin="5,0"
                              Stretch="Uniform" Fill="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" Margin="2,0"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock Text="v0.1.0 MVP" FontSize="11" Margin="0,0,10,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
