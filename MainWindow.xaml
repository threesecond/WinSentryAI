<Window x:Class="WinSentryAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:controls="clr-namespace:WinSentryAI.Controls"
        xmlns:views="clr-namespace:WinSentryAI.Views"
        xmlns:viewmodels="clr-namespace:WinSentryAI.ViewModels"
        mc:Ignorable="d"
        Title="WinSentryAI" Height="750" Width="1300" MinWidth="1280" MinHeight="720"
        Icon="Resources/Icons/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <!-- DataTemplates to map ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
            <views:EventListView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SystemInfoViewModel}">
            <views:SystemInfoView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AIReportViewModel}">
            <views:AIReportView DataContext="{Binding}"/>
        </DataTemplate>

        <!-- Tab button style for detail panel tabs -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource AppStatusPillBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AppStatusPillBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RemoteBannerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5E7EB"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#F3F4F6"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShellStatusPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource AppStatusPillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppStatusPillBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Figma-aligned sidebar item style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppActiveBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppActiveHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160"/> <!-- 左側導覽區 -->
            <ColumnDefinition Width="4"/>                 <!-- 垂直分隔線 -->
            <ColumnDefinition Width="*"/>                 <!-- 主要工作區 -->
        </Grid.ColumnDefinitions>

        <!-- 左側導覽區 -->
        <Border Grid.Column="0" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- App header -->
                <Border DockPanel.Dock="Top" Padding="16,18,14,14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#0078D4">
                            <TextBlock Text="&#xE83D;" Style="{StaticResource Mdl2IconTextStyle}"
                                       FontSize="17" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WinSentryAI" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppPrimaryTextBrush}" LineHeight="16"/>
                            <TextBlock Text="v0.9.0" FontSize="10" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sidebar footer -->
                <Border DockPanel.Dock="Bottom" Padding="10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                    <Border Style="{StaticResource ShellStatusPillStyle}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="&#xE10B;"
                                       Style="{StaticResource Mdl2IconTextStyle}"
                                       FontSize="11"
                                       Foreground="#107C10"
                                       Width="14"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppSecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Border>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                    <RadioButton GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="EventList"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualityConverter}, ConverterParameter=EventList}"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource Mdl2IconTextStyle}"
                                       Width="16" Opacity="0.75" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Nav_EventLog}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="SystemInfo"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualityConverter}, ConverterParameter=SystemInfo}"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE977;" Style="{StaticResource Mdl2IconTextStyle}"
                                       Width="16" Opacity="0.75" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Nav_SystemInfo}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="AIReport"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualityConverter}, ConverterParameter=AIReport}"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2IconTextStyle}"
                                       Width="16" Opacity="0.75" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Nav_AIReport}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Settings}"
                                 Style="{StaticResource SidebarNavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Mdl2IconTextStyle}"
                                       Width="16" Opacity="0.75" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 垂直 GridSplitter（可拖拉調整側邊欄寬度） -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}" Opacity="0.55"/>

        <!-- 右側主要區域 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>                                       <!-- Row 0: non-admin banner -->
                <RowDefinition Height="*"/>                                          <!-- Row 0: 主要內容 -->
                <RowDefinition x:Name="SplitterRow" Height="4"/>                    <!-- Row 1: 水平 GridSplitter -->
                <RowDefinition x:Name="DetailRow" Height="300" MinHeight="150"/>    <!-- Row 2: 底部詳細面板 -->
            </Grid.RowDefinitions>

            <!-- Row 0: banners (non-admin + remote mode) -->
            <StackPanel Grid.Row="0">
                <!-- Non-admin warning banner -->
                <Border Background="#FFF4CE" BorderBrush="#F2C94C" BorderThickness="0,0,0,1" Padding="14,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNonAdminMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Border Width="18" Height="18" CornerRadius="9" Background="#F2C94C" Margin="0,0,8,0">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Mdl2IconTextStyle}"
                                       Foreground="#5C4100" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource NonAdmin_Banner_Text}"
                                   Foreground="#5C4100" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Remote mode banner -->
                <Border Background="#0078D4" BorderBrush="#0065B8" BorderThickness="0,0,0,1" Padding="14,7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemoteMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding DisconnectRemoteCommand}"
                                Content="{DynamicResource Remote_Button_Disconnect}"
                                Style="{StaticResource RemoteBannerButtonStyle}"
                                Margin="12,0,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                        Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Remote_Banner_ActiveMode}"
                                        Foreground="White" FontSize="12" FontWeight="SemiBold"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border CornerRadius="4"
                                    Background="#0F3A5F"
                                    BorderBrush="#57A6E6"
                                    BorderThickness="1"
                                    Padding="7,2">
                                <TextBlock Text="{Binding RemoteHost}"
                                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Row 0: 主要內容區 -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>

            <!-- Row 1: 水平 GridSplitter -->
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="{DynamicResource AppBorderBrush}" Opacity="0.22"/>

            <!-- Row 2: 底部詳細面板 -->
            <Grid Grid.Row="3" DataContext="{Binding EventDetailViewModel}"
                  Background="{DynamicResource AppSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Tab header bar -->
                    <RowDefinition Height="*"/>    <!-- Tab content -->
                </Grid.RowDefinitions>

                <!-- Tab header bar -->
                <Border Grid.Row="0" Background="{DynamicResource AppSubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,1"
                        Padding="8,0">
                    <DockPanel LastChildFill="True">
                        <!-- Header actions (right) -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Button Command="{Binding AnalyzeCommand}"
                                    Style="{StaticResource ShellPrimaryButtonStyle}"
                                    Margin="0,5,8,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                    <TextBlock Text="{DynamicResource AI_Button_Analyze}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ShellStatusPillStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Background" Value="#0F3A5F"/>
                                        <Setter Property="BorderBrush" Value="#57A6E6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsRemoteMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="#0078D4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DataContext.RemoteHost, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding DataContext.ConnectRemoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Padding="9,2" FontSize="11" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsRemoteMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Remote_Button_ConnectRemote}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Tab buttons (left) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="DetailTab" Style="{StaticResource TabButtonStyle}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Detail}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                    <TextBlock Text="{DynamicResource EventDetail_Tab_Detail}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DetailTab" Style="{StaticResource TabButtonStyle}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Context}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                    <TextBlock Text="{DynamicResource EventDetail_Tab_Context}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DetailTab" Style="{StaticResource TabButtonStyle}"
                                         IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=AI}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                    <TextBlock Text="{DynamicResource EventDetail_Tab_AI}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · " Foreground="#777777" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AiModelName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AiModelName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding AiModelName}"
                                               MaxWidth="220"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#666666"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AiModelName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AiModelName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tab content area -->
                <Grid Grid.Row="1">

                    <!-- ══════════════════════════════════════════ -->
                    <!-- Tab 1: Event Detail                        -->
                    <!-- ══════════════════════════════════════════ -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Detail">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="16,10">
                            <!-- No event selected placeholder -->
                            <hc:Empty Description="{DynamicResource EventDetail_SelectEventPrompt}">
                                <hc:Empty.Style>
                                    <Style TargetType="hc:Empty">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:Empty.Style>
                            </hc:Empty>

                            <!-- Event fields (2-column layout) -->
                            <Grid>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                                    </Style>
                                </Grid.Resources>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEvent}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource EventDetail_Label_Source}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEvent.Source}" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource EventDetail_Label_Timestamp}" FontWeight="SemiBold" Margin="16,4,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedEvent.Timestamp}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource EventDetail_Label_ProviderName}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEvent.ProviderName}" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource EventDetail_Label_EventId}" FontWeight="SemiBold" Margin="16,4,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedEvent.EventId}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource EventDetail_Label_Level}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEvent.Level}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{DynamicResource EventDetail_Label_Host}" FontWeight="SemiBold" Margin="16,4,8,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedEvent.Host}" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource EventDetail_Label_Message}" FontWeight="SemiBold" Margin="0,4,8,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                                           Text="{Binding SelectedEvent.Message}" TextWrapping="Wrap" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ══════════════════════════════════════════ -->
                    <!-- Tab 2: AI Analysis                         -->
                    <!-- ══════════════════════════════════════════ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="AI">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Scrollable AI content -->
                            <RowDefinition Height="Auto"/> <!-- Pinned disclaimer + chat input -->
                        </Grid.RowDefinitions>

                        <!-- Scrollable AI content -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppPanelBackgroundBrush}">
                            <StackPanel Margin="16,12">

                                <!-- Idle hint -->
                                <Border CornerRadius="6" Padding="14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.04"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiIdle}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AppInfoBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Mdl2IconTextStyle}"
                                                       FontSize="14" Foreground="#0078D4"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource AI_Status_Idle}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- No key configured -->
                                <Border CornerRadius="6" Padding="14" BorderBrush="#F2C94C" BorderThickness="1" Background="#FFF4CE">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiNoKey}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Mdl2InlineIconTextStyle}" Foreground="#5C4100"/>
                                            <TextBlock Text="{DynamicResource AI_Status_NoKey}" TextWrapping="Wrap" FontSize="12" Foreground="#5C4100"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AiErrorMessage}" TextWrapping="Wrap" Margin="24,4,0,0" FontSize="12" Foreground="#5C4100">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAiErrorMessage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Loading -->
                                <Border CornerRadius="6" Padding="14" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9F5;" Style="{StaticResource Mdl2IconTextStyle}"
                                                   FontSize="16" Foreground="#0078D4" Width="20"/>
                                        <TextBlock Text="{DynamicResource AI_Status_Loading}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Failure -->
                                <Border CornerRadius="6" Padding="14" BorderBrush="#F2C7C3" BorderThickness="1" Background="#FDECEA">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiFailure}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEA39;" Style="{StaticResource Mdl2InlineIconTextStyle}" Foreground="#C42B1C"/>
                                            <TextBlock Text="{DynamicResource AI_Status_Failure}" FontWeight="SemiBold" FontSize="12" Foreground="#A5251A"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AiErrorMessage}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="#5C1B14"/>
                                    </StackPanel>
                                </Border>

                                <!-- Success: AI response + chat history -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiSuccess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border CornerRadius="6" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Border DockPanel.Dock="Right" CornerRadius="4" Background="{DynamicResource AppStatusPillBrush}" BorderBrush="{DynamicResource AppStatusPillBorderBrush}" BorderThickness="1" Padding="8,3">
                                                    <TextBlock Text="{Binding AiModelName}" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource AI_Section_Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding AiResponseSections}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAiResponseSections}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6"
                                                                Background="{DynamicResource AppSubtleSurfaceBrush}"
                                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                                BorderThickness="1"
                                                                Padding="12"
                                                                Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <DockPanel Margin="0,0,0,6">
                                                                    <Border DockPanel.Dock="Right"
                                                                            CornerRadius="4"
                                                                            Padding="8,2"
                                                                            Background="{DynamicResource AppStatusPillBrush}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Title}" Value="Severity">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SeverityBadgeText}" Value="Low">
                                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SeverityBadgeText}" Value="Medium">
                                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SeverityBadgeText}" Value="High">
                                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding SeverityBadgeText}" Value="Critical">
                                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding SeverityBadgeText}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="260">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#374151"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding SeverityBadgeText}" Value="Low">
                                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding SeverityBadgeText}" Value="Medium">
                                                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding SeverityBadgeText}" Value="High">
                                                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding SeverityBadgeText}" Value="Critical">
                                                                                            <Setter Property="Foreground" Value="#991B1B"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DisplayTitle}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding DisplayContent}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="18"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Text="{Binding AiResponseText, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource AppSecondaryTextBrush}"
                                                     VerticalScrollBarVisibility="Disabled">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAiResponseSections}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </Border>

                                    <Expander Header="{DynamicResource AI_Redaction_MapTitle}" Margin="0,0,0,10"
                                              Background="{DynamicResource AppSurfaceBrush}"
                                              BorderBrush="{DynamicResource AppBorderBrush}"
                                              Foreground="{DynamicResource AppPrimaryTextBrush}">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRedactionEntries}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <ItemsControl ItemsSource="{Binding RedactionEntries}" Margin="12,6,12,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Placeholder}" FontSize="11" FontWeight="SemiBold" Foreground="#0078D4"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Original}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>

                                    <!-- Chat history bubbles -->
                                    <TextBlock Text="{DynamicResource AI_Chat_Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppPrimaryTextBrush}"
                                               Margin="0,2,0,6"/>
                                    <Border CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                            Background="{DynamicResource AppInfoBrush}" BorderBrush="{DynamicResource AppInfoBorderBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasInitialAnalysisContext}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{DynamicResource AI_Chat_ContextProvided}"
                                                   FontSize="11"
                                                   Foreground="#0078D4"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding VisibleChatHistory}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="10" Margin="0,4" MaxWidth="620"
                                                        HorizontalAlignment="{Binding Role, Converter={StaticResource ChatRoleToAlignmentConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Role}" Value="User">
                                                                    <Setter Property="Background" Value="#0078D4"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <controls:MarkdownTextBlock Markdown="{Binding Content}"
                                                                                TextWrapping="Wrap"
                                                                                FontSize="12">
                                                        <controls:MarkdownTextBlock.Style>
                                                            <Style TargetType="{x:Type controls:MarkdownTextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Role}" Value="User">
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:MarkdownTextBlock.Style>
                                                    </controls:MarkdownTextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Chat loading indicator -->
                                    <hc:LoadingCircle IsRunning="{Binding IsChatLoading}"
                                                      Width="20" Height="20" HorizontalAlignment="Center" Margin="0,6">
                                        <hc:LoadingCircle.Style>
                                            <Style TargetType="hc:LoadingCircle">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChatLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </hc:LoadingCircle.Style>
                                    </hc:LoadingCircle>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pinned: Disclaimer + Chat input (OUTSIDE ScrollViewer) -->
                        <Border Grid.Row="1" Padding="16,8"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiSuccess}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource AI_Disclaimer_Text}"
                                           FontSize="10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,6"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <hc:TextBox Grid.Column="0"
                                                Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                                hc:InfoElement.Placeholder="{DynamicResource AI_Chat_Placeholder}">
                                        <hc:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}"/>
                                        </hc:TextBox.InputBindings>
                                    </hc:TextBox>
                                    <Button Grid.Column="1" Command="{Binding SendChatCommand}"
                                            Style="{StaticResource ButtonPrimary}"
                                            Padding="10,0" Margin="6,0,0,0">
                                        <TextBlock Text="&#xE898;" Style="{StaticResource Mdl2IconTextStyle}"
                                                   FontSize="12" Foreground="White" Width="12"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ══════════════════════════════════════════ -->
                    <!-- Tab 3: Context Events                      -->
                    <!-- ══════════════════════════════════════════ -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTab}" Value="Context">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <hc:LoadingCircle Grid.Row="0" IsRunning="{Binding IsContextLogsLoading}"
                                          Width="24" Height="24" HorizontalAlignment="Center" Margin="8">
                            <hc:LoadingCircle.Style>
                                <Style TargetType="hc:LoadingCircle">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContextLogsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:LoadingCircle.Style>
                        </hc:LoadingCircle>

                        <Grid Grid.Row="1" Background="{DynamicResource AppPanelBackgroundBrush}">
                            <hc:Empty Description="{DynamicResource EventDetail_NoContextLogs}"
                                      Visibility="{Binding ContextLogs.Count, Converter={StaticResource ZeroToVisibilityConverter}, FallbackValue=Collapsed}"/>
                            <ListView ItemsSource="{Binding ContextLogs}" Margin="8,4">
                                <ListView.Style>
                                    <Style TargetType="ListView">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}"/>
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                                        <Setter Property="ItemContainerStyle">
                                            <Setter.Value>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListViewItem">
                                                                <Border x:Name="Row"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4"
                                                                        Padding="6,5">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppHoverBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AppActiveBrush}"/>
                                                                        <Setter TargetName="Row" Property="BorderBrush" Value="#0078D4"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContextLogs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.Style>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Message}">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss '}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Level, StringFormat='{}{0}: '}" FontWeight="SemiBold"
                                                       Foreground="{Binding Level, Converter={StaticResource EventLevelToColorConverter}}"/>
                                            <TextBlock Text="{Binding Source, StringFormat='{}{0} '}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppPrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding EventId, StringFormat='(ID:{0})'}" FontStyle="Italic"
                                                       Foreground="{DynamicResource AppSecondaryTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
