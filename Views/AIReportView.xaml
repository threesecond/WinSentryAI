<UserControl x:Class="WinSentryAI.Views.AIReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:WinSentryAI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewmodels:AIReportViewModel}"
             Background="#F3F3F3"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="ReportMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="ReportMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="SeverityBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Low">
                    <Setter Property="Background" Value="#DCFCE7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                    <Setter Property="Background" Value="#FEF3C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Background" Value="#FEE2E2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Failed">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Low">
                    <Setter Property="Foreground" Value="#166534"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                    <Setter Property="Foreground" Value="#92400E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" BorderBrush="#EEF0F3" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF4FD"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#C7E0F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="24,16,24,14" Background="#FAFAFA" BorderThickness="0,0,0,1" BorderBrush="#E5E5E5">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding RefreshCommand}"
                        Padding="10,4"
                        FontSize="12"
                        Style="{StaticResource ButtonDefault}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                        <TextBlock Text="{DynamicResource AIReport_Button_Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{DynamicResource AIReport_Title}"
                               FontWeight="SemiBold"
                               FontSize="20"
                               Foreground="#1A1A1A"
                               LineHeight="26"/>
                    <TextBlock Text="{DynamicResource AIReport_Subtitle}"
                               FontSize="12"
                               Foreground="#888888"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AIReport_Metric_Total}" Style="{StaticResource ReportMetricLabelStyle}"/>
                            <TextBlock Text="{Binding TotalAnalyses}" Style="{StaticResource ReportMetricValueStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AIReport_Metric_Success}" Style="{StaticResource ReportMetricLabelStyle}"/>
                            <TextBlock Text="{Binding SuccessfulAnalyses}" Style="{StaticResource ReportMetricValueStyle}" Foreground="#166534"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AIReport_Metric_HighSeverity}" Style="{StaticResource ReportMetricLabelStyle}"/>
                            <TextBlock Text="{Binding HighSeverityAnalyses}" Style="{StaticResource ReportMetricValueStyle}" Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AIReport_Metric_Failed}" Style="{StaticResource ReportMetricLabelStyle}"/>
                            <TextBlock Text="{Binding FailedAnalyses}" Style="{StaticResource ReportMetricValueStyle}" Foreground="#4B5563"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid MinHeight="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="560"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#E5E5E5" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Padding="16,9" Background="#F8F8F8" BorderBrush="#EBEBEB" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" Style="{StaticResource Mdl2InlineIconTextStyle}" Foreground="#0078D4"/>
                                    <TextBlock Text="{DynamicResource AIReport_Section_Recent}" FontSize="12" FontWeight="SemiBold" Foreground="#333333"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1">
                            <TextBlock Text="{DynamicResource AIReport_Empty}"
                                       Foreground="#777777"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                                <ListBox ItemsSource="{Binding Items}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource ReportListItemStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="74" Margin="14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="92"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding AnalysisCreatedAt, StringFormat='MM-dd HH:mm'}"
                                                           FontSize="12"
                                                           Foreground="#4B5563"
                                                           VerticalAlignment="Center"/>

                                                <Border Grid.Column="1" Style="{StaticResource SeverityBadgeBorderStyle}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityBadgeTextStyle}"/>
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1F2937"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EventPreview}"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source}"
                                                               FontSize="11"
                                                               Foreground="#374151"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ModelDisplay}"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True"/>

                    <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#E5E5E5" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedItem}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        Style="{StaticResource SeverityBadgeBorderStyle}"
                                        DataContext="{Binding SelectedItem}">
                                    <TextBlock Text="{Binding Severity}" Style="{StaticResource SeverityBadgeTextStyle}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource AIReport_Detail_Title}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"/>
                            </DockPanel>

                            <StackPanel Grid.Row="1" Margin="0,14,0,14" DataContext="{Binding SelectedItem}">
                                <TextBlock Text="{Binding AnalysisCreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                           FontSize="12" Foreground="#4B5563"/>
                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="#4B5563" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding ModelDisplay}" FontSize="12" Foreground="#4B5563" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedItem}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource AIReport_Detail_Summary}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DetailText}"
                                               FontSize="12"
                                               Foreground="#1F2937"
                                               TextWrapping="Wrap"
                                               LineHeight="18"/>
                                    <TextBlock Text="{DynamicResource AIReport_Detail_Event}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#6B7280"
                                               Margin="0,18,0,4"/>
                                    <TextBlock Text="{Binding EventTitle}"
                                               FontSize="12"
                                               Foreground="#374151"
                                               TextWrapping="Wrap"
                                               LineHeight="18"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
