<UserControl x:Class="WinSentryAI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewmodels="clr-namespace:WinSentryAI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewmodels:SettingsViewModel}"
             Background="#F5F6F8"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="SettingsSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="SettingsLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="210"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <Style x:Key="SettingsUnitTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="SettingsRowStyle" TargetType="hc:FlexPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsInputStyle" TargetType="hc:TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SettingsPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDefault}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="SettingsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="hc:BorderElement.CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#D8DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCardHeaderStyle" TargetType="Border">
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Background" Value="#FBFCFD"/>
            <Setter Property="BorderBrush" Value="#E5EAF0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="SettingsInfoBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="28,18,28,16" Background="White" BorderThickness="0,0,0,1" BorderBrush="#E5EAF0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Settings_Title}"
                           FontWeight="SemiBold"
                           FontSize="22"
                           Foreground="#111827"
                           LineHeight="28"/>
                <TextBlock Text="{DynamicResource Settings_Subtitle}"
                           FontSize="12"
                           Foreground="#6B7280"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="1040" HorizontalAlignment="Left">
                <!-- General Settings -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingsCardHeaderStyle}">
                            <TextBlock Text="{DynamicResource Settings_Section_General}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,4">
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_LogRetentionDays}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <hc:NumericUpDown Value="{Binding LogRetentionDays}" Minimum="1" Maximum="365"
                                                  Width="120" Height="28" FontSize="12"/>
                                <TextBlock Text="{DynamicResource Settings_Unit_Days}" Style="{StaticResource SettingsUnitTextStyle}"/>
                            </hc:FlexPanel>
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_MaxRetroQueryCount}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <hc:NumericUpDown Value="{Binding MaxRetroQueryCount}" Minimum="10" Maximum="500"
                                                  Width="120" Height="28" FontSize="12"/>
                                <TextBlock Text="{DynamicResource Settings_Unit_Events}" Style="{StaticResource SettingsUnitTextStyle}"/>
                            </hc:FlexPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- AI Configuration -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingsCardHeaderStyle}">
                            <TextBlock Text="{DynamicResource Settings_Section_AI}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,4">
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_AIProvider}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <ComboBox ItemsSource="{Binding AiProviders}" SelectedItem="{Binding AiProvider}" Width="180" Style="{StaticResource SettingsComboBoxStyle}"/>
                            </hc:FlexPanel>

                            <Border Background="#FFFBEB" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12"
                                    Visibility="{Binding NeedsRestart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <hc:FlexPanel>
                                    <TextBlock Text="{DynamicResource Settings_Restart_Notice}" Foreground="#5C4100" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    <Button Command="{Binding RestartCommand}"
                                            Style="{StaticResource SettingsSecondaryButtonStyle}"
                                            Margin="15,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                            <TextBlock Text="{DynamicResource Settings_Button_Restart}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </hc:FlexPanel>
                            </Border>

                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_EnableRedaction}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <CheckBox IsChecked="{Binding EnableRedaction}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Settings_Redaction_Note}"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           Foreground="#555555"
                                           VerticalAlignment="Center"/>
                            </hc:FlexPanel>

                            <Border Background="#ECFDF5" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasModelFetchStatus}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ModelFetchStatusText}"
                                           FontSize="12"
                                           Foreground="#047857"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Provider Panels -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,14,14,4" Margin="0,2,0,10">
                            <Grid>
                                <!-- Gemini Panel -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AiProvider}" Value="gemini">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border Style="{StaticResource SettingsInfoBannerStyle}">
                                        <TextBlock Text="{Binding GeminiKeyStatusText}" FontSize="11" Foreground="#0078D4" TextWrapping="Wrap"/>
                                    </Border>

                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_GeminiModel}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding GeminiModels}"
                                                  Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="280" Style="{StaticResource SettingsComboBoxStyle}"/>
                                    </hc:FlexPanel>
                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_GeminiApiKey}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <PasswordBox x:Name="GeminiKeyPasswordBox" Width="260" Style="{StaticResource SettingsPasswordBoxStyle}"/>
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                            <Hyperlink NavigateUri="https://ai.google.dev/gemini-api/docs/api-key" RequestNavigate="Hyperlink_RequestNavigate">
                                                <Run Text="{DynamicResource Settings_Link_GetApiKey}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </hc:FlexPanel>
                                    <StackPanel Orientation="Horizontal" Margin="226,0,0,12">
                                        <Button Style="{StaticResource SettingsPrimaryButtonStyle}" Click="SaveGeminiKey_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_SaveGeminiKey}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SettingsSecondaryButtonStyle}" Click="ClearGeminiKey_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_ClearGeminiKey}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding FetchGeminiModelsCommand}"
                                                IsEnabled="{Binding IsGeminiKeySet}" Style="{StaticResource SettingsSecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_FetchGeminiModels}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- OpenAI Panel -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AiProvider}" Value="openai">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border Style="{StaticResource SettingsInfoBannerStyle}">
                                        <TextBlock Text="{Binding OpenAiKeyStatusText}" FontSize="11" Foreground="#0078D4" TextWrapping="Wrap"/>
                                    </Border>

                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_OpenAiModel}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding OpenAiModels}"
                                                  Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="280" Style="{StaticResource SettingsComboBoxStyle}"/>
                                    </hc:FlexPanel>
                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_OpenAiApiKey}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <PasswordBox x:Name="OpenAiKeyPasswordBox" Width="260" Style="{StaticResource SettingsPasswordBoxStyle}"/>
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                            <Hyperlink NavigateUri="https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key" RequestNavigate="Hyperlink_RequestNavigate">
                                                <Run Text="{DynamicResource Settings_Link_GetApiKey}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </hc:FlexPanel>
                                    <StackPanel Orientation="Horizontal" Margin="226,0,0,12">
                                        <Button Style="{StaticResource SettingsPrimaryButtonStyle}" Click="SaveOpenAiKey_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_SaveOpenAiKey}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SettingsSecondaryButtonStyle}" Click="ClearOpenAiKey_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_ClearOpenAiKey}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding FetchOpenAiModelsCommand}"
                                                IsEnabled="{Binding IsOpenAiKeySet}" Style="{StaticResource SettingsSecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_FetchGeminiModels}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Claude Panel -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AiProvider}" Value="claude">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border Style="{StaticResource SettingsInfoBannerStyle}">
                                        <TextBlock Text="{Binding ClaudeKeyStatusText}" FontSize="11" Foreground="#0078D4" TextWrapping="Wrap"/>
                                    </Border>

                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_ClaudeModel}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding ClaudeModels}"
                                                  Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="280" Style="{StaticResource SettingsComboBoxStyle}"/>
                                    </hc:FlexPanel>
                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_ClaudeApiKey}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <PasswordBox x:Name="ClaudeKeyPasswordBox" Width="260" Style="{StaticResource SettingsPasswordBoxStyle}"/>
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12">
                                            <Hyperlink NavigateUri="https://platform.claude.com/docs/en/api/admin/api_keys/retrieve" RequestNavigate="Hyperlink_RequestNavigate">
                                                <Run Text="{DynamicResource Settings_Link_GetApiKey}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </hc:FlexPanel>
                                    <StackPanel Orientation="Horizontal" Margin="226,0,0,12">
                                        <Button Style="{StaticResource SettingsPrimaryButtonStyle}" Click="SaveClaudeKey_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74E;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_SaveClaudeKey}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SettingsSecondaryButtonStyle}" Click="ClearClaudeKey_Click" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_ClearClaudeKey}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding FetchClaudeModelsCommand}"
                                                IsEnabled="{Binding IsClaudeKeySet}" Style="{StaticResource SettingsSecondaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Button_FetchGeminiModels}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Ollama Panel -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AiProvider}" Value="ollama">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_OllamaEndpoint}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <hc:TextBox Text="{Binding OllamaEndpoint}" Width="300" hc:InfoElement.Placeholder="http://localhost:11434" Style="{StaticResource SettingsInputStyle}"/>
                                    </hc:FlexPanel>
                                    <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                        <TextBlock Text="{DynamicResource Settings_Label_OllamaModel}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding OllamaModels}" SelectedItem="{Binding OllamaModel}" Width="200" IsEditable="True" Style="{StaticResource SettingsComboBoxStyle}"/>
                                        <Button Command="{Binding FetchOllamaModelsCommand}"
                                                Style="{StaticResource SettingsSecondaryButtonStyle}"
                                                Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                                <TextBlock Text="{DynamicResource Settings_Ollama_TestAndFetch}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </hc:FlexPanel>
                                </StackPanel>
                            </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error Handling -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingsCardHeaderStyle}">
                            <TextBlock Text="{DynamicResource Settings_Section_ErrorHandling}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,4">
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_MaxRetryCount}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <hc:NumericUpDown Value="{Binding MaxRetryCount}" Minimum="1" Maximum="10"
                                                  Width="120" Height="28" FontSize="12"/>
                                <TextBlock Text="{DynamicResource Settings_Unit_Times}" Style="{StaticResource SettingsUnitTextStyle}"/>
                            </hc:FlexPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- UI Settings -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingsCardHeaderStyle}">
                            <TextBlock Text="{DynamicResource Settings_Section_UI}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,4">
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_Theme}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <ComboBox ItemsSource="{Binding UiThemes}" SelectedItem="{Binding UiTheme}" Width="200" IsEnabled="False" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <TextBlock Text="{DynamicResource Settings_Theme_NotImplemented}"
                                           Margin="10,0,0,0"
                                           FontSize="12"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                            </hc:FlexPanel>
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_Language}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <ComboBox ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding UiLanguage}" Width="200" Style="{StaticResource SettingsComboBoxStyle}"/>
                            </hc:FlexPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Maintenance -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingsCardHeaderStyle}">
                            <TextBlock Text="{DynamicResource Settings_Section_Maintenance}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,4">
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_ClearLogs}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <Button Command="{Binding ClearAllLogsCommand}"
                                        Style="{StaticResource SettingsDangerButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                        <TextBlock Text="{DynamicResource Settings_Button_ClearLogs}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </hc:FlexPanel>
                            <hc:FlexPanel Style="{StaticResource SettingsRowStyle}">
                                <TextBlock Text="{DynamicResource Settings_Label_About}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <Button Command="{Binding ShowAboutCommand}"
                                        Style="{StaticResource SettingsSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                                        <TextBlock Text="{DynamicResource Settings_Button_About}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </hc:FlexPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Remote Connection Section -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource SettingsCardHeaderStyle}">
                            <TextBlock Text="{DynamicResource Settings_Section_Remote}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="18,14,18,14">
                            <!-- "Not configured" message -->
                            <TextBlock Text="{DynamicResource Settings_Remote_NotConfigured}"
                                       FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"
                                       Visibility="{Binding HasLastRemoteHost, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <!-- Last Host -->
                            <hc:FlexPanel Margin="0,0,0,8"
                                          Visibility="{Binding HasLastRemoteHost, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Settings_Label_LastHost}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <TextBlock Text="{Binding LastRemoteHost}" FontSize="12" VerticalAlignment="Center" Foreground="#333333"/>
                            </hc:FlexPanel>
                            <!-- Last Domain -->
                            <hc:FlexPanel Margin="0,0,0,8"
                                          Visibility="{Binding HasLastRemoteHost, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Settings_Label_LastDomain}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <TextBlock Text="{Binding LastRemoteDomain}" FontSize="12" VerticalAlignment="Center" Foreground="#333333"/>
                            </hc:FlexPanel>
                            <!-- Last Username -->
                            <hc:FlexPanel Margin="0,0,0,4"
                                          Visibility="{Binding HasLastRemoteHost, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource Settings_Label_LastUsername}" Style="{StaticResource SettingsLabelTextStyle}"/>
                                <TextBlock Text="{Binding LastRemoteUsername}" FontSize="12" VerticalAlignment="Center" Foreground="#333333"/>
                            </hc:FlexPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Padding="28,12" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E5EAF0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding LoadSettingsCommand}" Style="{StaticResource SettingsSecondaryButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                        <TextBlock Text="{DynamicResource Settings_Button_Load}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveSettingsCommand}" Style="{StaticResource SettingsPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Mdl2InlineIconTextStyle}"/>
                        <TextBlock Text="{DynamicResource Settings_Button_Save}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
