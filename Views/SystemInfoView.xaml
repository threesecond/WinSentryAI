<UserControl x:Class="WinSentryAI.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:WinSentryAI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewmodels:SystemInfoViewModel}"
             Background="{DynamicResource AppWindowBackgroundBrush}"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="SystemInfoSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SystemInfoLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="180"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SystemInfoValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SystemInfoRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="24,16,24,14" Background="{DynamicResource AppSurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}">
            <StackPanel>
                <TextBlock Text="{DynamicResource SysInfo_Title}"
                           FontWeight="SemiBold"
                           FontSize="20"
                           Foreground="{DynamicResource AppPrimaryTextBrush}"
                           LineHeight="26"/>
                <TextBlock Text="{DynamicResource SysInfo_Subtitle}"
                           FontSize="12"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Operating System -->
                <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="16,9" Background="{DynamicResource AppSubtleSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE977;" Style="{StaticResource Mdl2InlineIconTextStyle}" Foreground="#0078D4"/>
                                <TextBlock Text="{DynamicResource SysInfo_Section_OS}" Style="{StaticResource SystemInfoSectionHeaderTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="16,12,16,0">
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_OsVersion}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding OsVersion}" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_OsBuild}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding OsBuild}" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_ComputerName}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding ComputerName}" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_Domain}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding DomainOrWorkgroup}" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hardware -->
                <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="16,9" Background="{DynamicResource AppSubtleSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" Style="{StaticResource Mdl2InlineIconTextStyle}" Foreground="#0078D4"/>
                                <TextBlock Text="{DynamicResource SysInfo_Section_Hardware}" Style="{StaticResource SystemInfoSectionHeaderTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="16,12,16,0">
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_CpuName}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding CpuName}" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_TotalRam}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TotalRamMb}" Style="{StaticResource SystemInfoValueTextStyle}"/>
                                    <TextBlock Text="{DynamicResource SysInfo_Unit_MB}" Margin="5,0,0,0" Style="{StaticResource SystemInfoValueTextStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_GpuInfo}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding GpuInfo}" MinWidth="360" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Network -->
                <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Padding="16,9" Background="{DynamicResource AppSubtleSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE701;" Style="{StaticResource Mdl2InlineIconTextStyle}" Foreground="#0078D4"/>
                                <TextBlock Text="{DynamicResource SysInfo_Section_Network}" Style="{StaticResource SystemInfoSectionHeaderTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="16,12,16,0">
                            <StackPanel Style="{StaticResource SystemInfoRowStyle}">
                                <TextBlock Text="{DynamicResource SysInfo_Label_IpAddresses}" Style="{StaticResource SystemInfoLabelTextStyle}"/>
                                <TextBlock Text="{Binding IpAddresses}" MinWidth="360" Style="{StaticResource SystemInfoValueTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
