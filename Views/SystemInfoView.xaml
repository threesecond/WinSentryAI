<UserControl x:Class="WinSentryAI.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:viewmodels="clr-namespace:WinSentryAI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance viewmodels:SystemInfoViewModel}"
             Background="{DynamicResource SecondaryRegionBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="15" Background="{DynamicResource RegionBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <TextBlock Text="{DynamicResource SysInfo_Title}" FontWeight="Bold" FontSize="20"/>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Operating System -->
                <hc:Card Header="{DynamicResource SysInfo_Section_OS}" Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_OsVersion}" Width="150" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OsVersion}" TextWrapping="Wrap"/>
                        </hc:FlexPanel>
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_OsBuild}" Width="150" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OsBuild}"/>
                        </hc:FlexPanel>
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_ComputerName}" Width="150" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ComputerName}"/>
                        </hc:FlexPanel>
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_Domain}" Width="150" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DomainOrWorkgroup}"/>
                        </hc:FlexPanel>
                    </StackPanel>
                </hc:Card>

                <!-- Hardware -->
                <hc:Card Header="{DynamicResource SysInfo_Section_Hardware}" Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_CpuName}" Width="150" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap"/>
                        </hc:FlexPanel>
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_TotalRam}" Width="150" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalRamMb}"/>
                                <TextBlock Text="{DynamicResource SysInfo_Unit_MB}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </hc:FlexPanel>
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_GpuInfo}" Width="150" FontWeight="SemiBold" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding GpuInfo}" TextWrapping="Wrap"/>
                        </hc:FlexPanel>
                    </StackPanel>
                </hc:Card>

                <!-- Network -->
                <hc:Card Header="{DynamicResource SysInfo_Section_Network}" Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <hc:FlexPanel Margin="0,5">
                            <TextBlock Text="{DynamicResource SysInfo_Label_IpAddresses}" Width="150" FontWeight="SemiBold" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding IpAddresses}" TextWrapping="Wrap"/>
                        </hc:FlexPanel>
                    </StackPanel>
                </hc:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
