<Window x:Class="WinSentryAI.RemoteConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:vm="clr-namespace:WinSentryAI.ViewModels"
        mc:Ignorable="d"
        Title="{DynamicResource Remote_Dialog_Title}"
        Height="660" Width="520"
        MinHeight="560" MinWidth="500"
        Icon="Resources/Icons/AppIcon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance vm:RemoteConnectionViewModel}"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="hc:TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppPrimaryTextBrush}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppPrimaryTextBrush}"/>
            <Setter Property="SelectionBrush" Value="#0078D4"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Padding="24" Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Hostname -->
                        <RowDefinition Height="Auto"/> <!-- Credentials -->
                        <RowDefinition Height="Auto"/> <!-- Query range -->
                        <RowDefinition Height="Auto"/> <!-- Limitation note -->
                        <RowDefinition Height="Auto"/> <!-- Status message -->
                    </Grid.RowDefinitions>

                    <!-- Hostname -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Remote_Label_Hostname}"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                        <hc:TextBox x:Name="HostnameInput"
                                    Text="{Binding Hostname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="{DynamicResource Remote_Placeholder_Hostname}"/>
                    </StackPanel>

                    <!-- Credentials -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Remote_Label_Credentials}"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                        <RadioButton Content="{DynamicResource Remote_Radio_CurrentUser}" Margin="0,0,0,6"
                                     IsChecked="{Binding CredentialMode, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Current}"/>
                        <RadioButton Content="{DynamicResource Remote_Radio_SpecifyUser}" Margin="0,0,0,8"
                                     IsChecked="{Binding CredentialMode, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Specify}"/>

                        <!-- Specify credentials fields -->
                        <StackPanel Margin="20,0,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CredentialMode}" Value="Specify">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Remote_Label_Domain}"
                                           FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                                <hc:TextBox Text="{Binding Domain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            hc:InfoElement.Placeholder="{DynamicResource Remote_Placeholder_Domain}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Remote_Label_Username}"
                                           FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                                <hc:TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Remote_Label_Password}"
                                           FontSize="11" FontWeight="Medium" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Remote_Note_PasswordNotSaved}"
                                           FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Query Range -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource Remote_Label_QueryRange}"
                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <RadioButton Content="{DynamicResource Remote_Range_1h}" Margin="0,0,16,8"
                                         IsChecked="{Binding QueryRangeHours, Converter={StaticResource StringEqualityConverter}, ConverterParameter=1}"/>
                            <RadioButton Content="{DynamicResource Remote_Range_6h}" Margin="0,0,16,8"
                                         IsChecked="{Binding QueryRangeHours, Converter={StaticResource StringEqualityConverter}, ConverterParameter=6}"/>
                            <RadioButton Content="{DynamicResource Remote_Range_24h}" Margin="0,0,16,8"
                                         IsChecked="{Binding QueryRangeHours, Converter={StaticResource StringEqualityConverter}, ConverterParameter=24}"/>
                            <RadioButton Content="{DynamicResource Remote_Range_7d}" Margin="0,0,0,8"
                                         IsChecked="{Binding QueryRangeHours, Converter={StaticResource StringEqualityConverter}, ConverterParameter=168}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Limitation Note -->
                    <Border Grid.Row="3" Background="{DynamicResource AppInfoBrush}" BorderBrush="{DynamicResource AppInfoBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#1D4ED8" Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{DynamicResource Remote_Note_NoRealtimeMonitoring}"
                                       TextWrapping="Wrap" FontSize="11" Foreground="#0078D4"/>
                        </DockPanel>
                    </Border>

                    <!-- Status Message -->
                    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,0,0,8" MinHeight="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{DynamicResource Remote_Button_Cancel}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource ButtonDefault}"
                        Margin="0,0,10,0"/>
                <Button x:Name="ConnectButton"
                        Content="{DynamicResource Remote_Button_Connect}"
                        IsEnabled="{Binding IsConnectEnabled}"
                        Click="ConnectButton_Click"
                        Style="{StaticResource ButtonPrimary}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
